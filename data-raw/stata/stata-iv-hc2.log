. 
. capture program drop dumpfit

. program define dumpfit
  1.     args tag
  2.     tempname b_ V_
  3.     matrix `b_' = e(b)
  4.     matrix `V_' = e(V)
  5.     local k = colsof(`b_')
  6.     local nm : colnames `b_'
  7.     display "RESULT|`tag'.k|`k'"
  8.     display "RESULT|`tag'.names|`nm'"
  9.     display "RESULT|`tag'.N|" e(N)
 10.     display "RESULT|`tag'.df_r|" e(df_r)
 11.     forvalues i = 1/`k' {
 12.         display "RESULT|`tag'.b_`i'|" %24.17e `b_'[1,`i']
 13.         forvalues j = 1/`k' {
 14.             display "RESULT|`tag'.V_`i'_`j'|" %24.17e `V_'[`i',`j']
 15.         }
 16.     }
 17. end

. 
. // Run a command; record whether Stata accepted it, and dump the fit if so.
. capture program drop tryfit

. program define tryfit
  1.     args tag cmdline
  2.     capture noisily `cmdline'
  3.     local rc = _rc
  4.     display "RESULT|`tag'.rc|`rc'"
  5.     if `rc' == 0 {
  6.         dumpfit "`tag'"
  7.     }
  8.     else {
  9.         display "RESULT|`tag'.refused|1"
 10.     }
 11. end

